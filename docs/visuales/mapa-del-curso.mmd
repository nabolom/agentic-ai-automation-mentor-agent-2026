%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Inter, ui-sans-serif, system-ui", "primaryColor": "#E9E7FF", "primaryTextColor": "#172033", "primaryBorderColor": "#5B5BD6", "lineColor": "#6B7280", "secondaryColor": "#FFF1EA", "tertiaryColor": "#EAF7F2"}}}%%
flowchart TD
    Entrada[Alumno: automatización, idea o duda] --> Rumbo["/rumbo: elegir foco"]
    Rumbo --> SesionDos[Sesión 2: evals y línea base]
    SesionDos --> SesionTres[Sesión 3: diagnóstico por capas]
    SesionTres --> Decision{¿Hay iteración real?}
    Decision -->|No| NoLoop[Checker externo y no-loop]
    Decision -->|Sí| Loop[Cuatro paradas y una traza]
    NoLoop --> SesionCuatro[Sesión 4: gobernanza y handoff]
    Loop --> SesionCuatro
    SesionCuatro --> Cierre[Demo: otra persona puede operar]
    Cierre --> Nucleo[Sistema explicable y operable]
    SesionDos -. fallback .-> Camino[Camino dorado offline]

    classDef start fill:#172033,color:#FFFFFF,stroke:#172033,stroke-width:2px;
    classDef mentor fill:#E9E7FF,color:#172033,stroke:#5B5BD6,stroke-width:1.5px;
    classDef session fill:#FFF1EA,color:#172033,stroke:#E77B52,stroke-width:1.5px;
    classDef decision fill:#EAF7F2,color:#172033,stroke:#3B9B78,stroke-width:1.5px;
    classDef finish fill:#172033,color:#FFFFFF,stroke:#172033,stroke-width:2px;
    class Entrada start;
    class Decision decision;
    class Rumbo,Camino,NoLoop,Loop,Cierre mentor;
    class SesionDos,SesionTres,SesionCuatro session;
    class Nucleo finish;
